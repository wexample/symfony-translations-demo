{%- extends '@front/layouts/private/layout.html.twig' -%}

{%- set page_show_title = true -%}

{%- block page_body -%}
    <p class="text-secondary">{{ '@page::intro' | trans }}</p>

    <div class="translations-demo--locales">
        {{ properties([
            { key: '@page::locale.current' | trans, value: app.request.locale },
            { key: '@page::locale.source' | trans, value: source_locale },
        ]) }}
        {{ component(render_pass, '@WexampleSymfonyTranslationsDsBundle/components/locale-switcher') }}
    </div>

    {#- The source reads the entity, the other column the same entity through
        translated(): the table shows what the mechanism adds, field by field. -#}
    {%- for article in articles -%}
        {%- set translated_article = translated(article) -%}
        <h2>{{ translated_article.title }}</h2>
        {{ data_table([
            { key: 'field', label: '@page::column.field' | trans, width: 's', class: 'table--cell--nowrap' },
            { key: 'source', label: '@page::column.source' | trans, cell: 'html' },
            { key: 'translated', label: '@page::column.translated' | trans, cell: 'html' },
        ], [
            { field: '@page::field.title' | trans, source: article.title, translated: translated_article.title },
            { field: '@page::field.summary' | trans, source: article.summary, translated: translated_article.summary },
        ], {
            striped: true,
        }) }}
    {%- endfor -%}
{%- endblock -%}
