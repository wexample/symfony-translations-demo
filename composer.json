{
  "name": "wexample/symfony-translations-demo",
  "version": "2.0.26",
  "type": "library",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "Wexample\\SymfonyTranslationsDemo\\": "src/"
    }
  },
  "description": "Demo of wexample/symfony-translations: localized urls, interface and entity content translation",
  "require": {
    "php": ">=8.5",
    "wexample/symfony-content": ">=4.0.12",
    "wexample/symfony-design-system": ">=41.0.0",
    "wexample/symfony-helpers": ">=19.1.0",
    "wexample/symfony-loader": ">=26.0.0",
    "wexample/symfony-translations": ">=17.0.1",
    "wexample/symfony-translations-ds": ">=2.0.20"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../*",
      "options": {
        "symlink": true
      }
    }
  ],
  "extra": {
    "install": {
      "bundle_env": "all"
    }
  }
}