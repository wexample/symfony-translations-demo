{
  "name": "wexample/symfony-translations-demo",
  "version": "2.0.18",
  "type": "library",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "Wexample\\SymfonyTranslationsDemo\\": "src/"
    }
  },
  "description": "Demo of wexample/symfony-translations: localized urls, interface and entity content translation",
  "require": {
    "php": ">=8.5",
    "wexample/symfony-content": "*",
    "wexample/symfony-design-system": ">=39.0.0",
    "wexample/symfony-helpers": ">=18.0.0",
    "wexample/symfony-loader": ">=24.0.0",
    "wexample/symfony-translations": ">=16.0.0",
    "wexample/symfony-translations-ds": ">=2.0.0"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../*",
      "options": {
        "symlink": true
      }
    }
  ],
  "extra": {
    "install": {
      "bundle_env": "all"
    }
  }
}